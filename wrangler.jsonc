{
  // Car maintenance tracker: one Worker serving the UI (static assets) and the API.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "car-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Daily at 8 AM Central (13:00 UTC; 7 AM in winter): recall check (weekly) + reminder emails.
  "triggers": { "crons": ["0 13 * * *"] },

  // Only reachable through the custom domain, which sits behind Cloudflare Access.
  // The workers.dev URL would bypass Access, so it stays off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cars.justdob.com", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "car-tracker",
      // Replaced with the real id after `wrangler d1 create car-tracker` (see README).
      "database_id": "8da34d44-7693-4d5e-8f68-705478cdbff8",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "car-tracker-files" }
  ],

  "vars": {
    // Filled in when the Cloudflare Access app is created (see README).
    // While empty, the API only answers on localhost.
    "ACCESS_TEAM_DOMAIN": "blue-butterfly-5547.cloudflareaccess.com",
    "ACCESS_AUD": "091ccd1bf556ed49486f1aa811b94e0d94591a3ccab74010d9d038c7dc24cd83",
    // Reminder emails go out through Resend from this address (cars.justdob.com is verified in Resend;
    // justdob.com's own mail stays on Microsoft 365).
    "MAIL_FROM": "Garage <garage@cars.justdob.com>",
    "APP_URL": "https://cars.justdob.com"
  }
  // Secrets (not here; `wrangler secret put <NAME>`):
  //   ANTHROPIC_API_KEY  receipt reading
  //   RESEND_API_KEY     reminder emails (sending-only key)
}
